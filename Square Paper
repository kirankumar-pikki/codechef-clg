import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	Scanner sc=new Scanner(System.in);
	int a=sc.nextInt();
	int b =sc.nextInt();
	int side=0;
	if(a>b){
	    side=b;
	}
	else if(b>a){
	    side=a;
	}
	else if(a==b){
	    side=a;
	}
	
	System.out.println(side*side);
	}
}
