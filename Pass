class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int t=sc.nextInt();
		
		
		while(t!=0){
		    int count60=0;
		    int count30=0;
		    for(int i=0;i<5;i++){
		        
		        int marks=sc.nextInt();
		        if(marks>=60){
		            count60++;
		            count30++;
		            }
		        
		        else if(marks>=30){
		            count30++;
		        }
		        
		    }
		    if(count60>=2 && count30>=4){
		            System.out.println("Pass");
		        }
		        else{
		            System.out.println("Fail");
		        }
		     t--;   
